^Xhead -130 ./src/components/ClaraKIPanel.jsx | tail -10/** * 
 ClaraKIPanel.jsx * AI Chat Interface for Clara360 - Phase 2 Integration 
 * Provides intelligent conversation capabilities within existing UI * * 
 Author: Manus A */
sed -n '120,130p' ./src/components/ClaraKIPanel.jsx import React, { 
useState, useRef, useEffect } from 'react'; import { Card } from 
'./ui/card'; import { Button } from './ui/button'; import { useClaraAI, 
useClaraChat } from '../context/ClaraAIProvider'; import { sed -n 
'120,130p' ./src/components/ClaraKIPanel.jsx MessageCircle,
  Send, 
  Brain, 
  Clock, 
  TrendingUp,
  AlertTriangle,
  CheckCircle,
  Lightbulb,
  X
} from 'lucide-react';

export function ClaraKIPanel({ isOpen, onClose }) {
  const [message, setMessage] = useState('');
  const [isMinimized, setIsMinimized] = useState(false);
  const messagesEndRef = useRef(null);
  
  const { sendMessage, conversations, loading, error } = useClaraChat();
  const { insights, generateInsights } = useClaraAI();

  // Auto-scroll to bottom of messages
  useEffect(() => {
    messagesEndRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [conversations]);

  // Handle message send
  const handleSendMessage = async (e) => {
    e.preventDefault();
    if (!message.trim() || loading) return;

    const userMessage = message.trim();
    setMessage('');

    try {
      await sendMessage(userMessage, {
        source: 'clara_ki_panel',
        timestamp: new Date().toISOString()
      });
    } catch (error) {
      console.error('Failed to send message:', error);
    }
  };

  // Quick action buttons
  const quickActions = [
    {
      label: 'Finanzübersicht',
      query: 'Wie ist die aktuelle Finanzlage der Waldhofstraße 76?',
      icon: TrendingUp
    },
    {
      label: 'Rückstände prüfen',
      query: 'Welche Mieter haben Zahlungsrückstände?',
      icon: AlertTriangle
    },
    {
      label: 'Wartungsaufgaben',
      query: 'Welche Wartungsarbeiten stehen an?',
      icon: CheckCircle
    },
    {
      label: 'Insights generieren',
      query: 'Generiere proaktive Empfehlungen für die Hausverwaltung',
      icon: Lightbulb
    }
  ];

  const handleQuickAction = async (query) => {
    setMessage(query);
    await sendMessage(query, {
      source: 'quick_action',
      timestamp: new Date().toISOString()
    });
  };

  if (!isOpen) return null;

  return (
    <div className="fixed bottom-4 right-4 w-96 h-[600px] bg-white rounded-lg shadow-2xl border border-gray-200 flex flex-col z-50">
      {/* Header */}
      <div className="flex items-center justify-between p-4 border-b border-gray-200 bg-blue-50 rounded-t-lg">
        <div className="flex items-center space-x-2">
          <Brain className="w-5 h-5 text-blue-600" />
          <h3 className="font-semibold text-gray-900">Clara KI</h3>
          {loading && <Clock className="w-4 h-4 text-blue-600 animate-spin" />}
        </div>
        <div className="flex items-center space-x-2">
          <Button
            variant="ghost"
            size="sm"
            onClick={() => setIsMinimized(!isMinimized)}
            className="p-1"
          >
            {isMinimized ? '□' : '_'}
          </Button>
          <Button
            variant="ghost"
            size="sm"
            onClick={onClose}
            className="p-1"
          >
            <X className="w-4 h-4" />
          </Button>
        </div>
      </div>

      {!isMinimized && (
        <>
          {/* Messages Area */}
          <div className="flex-1 overflow-y-auto p-4 space-y-4">
            {conversations.length === 0 ? (
              <div className="text-center text-gray-500 mt-8">
                <Brain className="w-12 h-12 text-gray-300 mx-auto mb-4" />
                <p className="text-sm">Hallo! Ich bin Clara KI.</p>
                <p className="text-xs mt-1">Fragen Sie mich alles zur Hausverwaltung.</p>
              </div>
            ) : (
              conversations.map((conv) => (
                <div key={conv.id} className="space-y-2">
                  {/* User Message */}
                  <div className="flex justify-end">
                    <div className="bg-blue-600 text-white rounded-lg px-3 py-2 max-w-[80%]">
                      <p className="text-sm">{conv.query}</p>
                    </div>
                  </div>
                  
                  {/* AI Response */}
                  <div className="flex justify-start">
                    <div className="bg-gray-100 text-gray-900 rounded-lg px-3 py-2 max-w-[80%]">
                      <p className="text-sm">{conv.response}</p>
                      <p className="text-xs text-gray-500 mt-1">
                        {new Date(conv.timestamp).toLocaleTimeString('de-DE')}
                      </p>
                    </div>
                  </div>
                </div>
              ))
            )}
            
            {/* Error Display */}
            {error && (
              <div className="bg-red-50 border border-red-200 rounded-lg p-3">
                <p className="text-red-600 text-sm">{error}</p>
              </div>
            )}
            
            <div ref={messagesEndRef} />
          </div>

          {/* Quick Actions */}
          {conversations.length === 0 && (
            <div className="p-4 border-t border-gray-200">
              <p className="text-xs text-gray-600 mb-2">Schnellaktionen:</p>
              <div className="grid grid-cols-2 gap-2">
                {quickActions.map((action, index) => (
                  <Button
                    key={index}
                    variant="outline"
                    size="sm"
                    onClick={() => handleQuickAction(action.query)}
                    className="text-xs p-2 h-auto flex flex-col items-center space-y-1"
                    disabled={loading}
                  >
                    <action.icon className="w-3 h-3" />
                    <span>{action.label}</span>
                  </Button>
                ))}
              </div>
            </div>
          )}

          {/* Input Area */}
          <div className="p-4 border-t border-gray-200">
            <form onSubmit={handleSendMessage} className="flex space-x-2">
              <input
                type="text"
                value={message}
                onChange={(e) => setMessage(e.target.value)}
                placeholder="Fragen Sie Clara KI..."
                className="flex-1 px-3 py-2 border border-gray-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-blue-500"
                disabled={loading}
              />
              <Button
                type="submit"
                size="sm"
                disabled={!message.trim() || loading}
                className="px-3"
              >
                <Send className="w-4 h-4" />
              </Button>
            </form>
          </div>
        </>
      )}
    </div>
  );
}

/**
 * Clara KI Floating Button
 * Provides access to the AI chat interface
 */
export function ClaraKIButton({ onClick }) {
  return (
    <Button
      onClick={onClick}
      className="fixed bottom-4 right-4 w-14 h-14 rounded-full bg-blue-600 hover:bg-blue-700 shadow-lg z-40"
      title="Clara KI öffnen"
    >
      <Brain className="w-6 h-6 text-white" />
    </Button>
  );
}

export default ClaraKIPanel;

