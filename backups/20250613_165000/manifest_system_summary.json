{
  "manifestSystem": {
    "description": "DSGVO-konformes Systemgedächtnis für Clara360",
    "version": "1.0.0",
    "implementation": "complete",
    "components": {
      "database": {
        "tables": [
          {
            "name": "users",
            "purpose": "Benutzer mit Rollen und Berechtigungen",
            "fields": ["id", "email", "role", "permissions", "created_at", "updated_at"]
          },
          {
            "name": "manifest", 
            "purpose": "Systemkontext als JSONB",
            "fields": ["id", "context_json", "last_updated_by", "visible_to_roles", "version", "created_at", "updated_at"]
          }
        ],
        "security": {
          "rls": "enabled",
          "policies": [
            "Users can read own data or metaGovernor can read all",
            "Allow read for governor & manus",
            "Allow update for governor & manus", 
            "Allow insert for governor & manus"
          ]
        }
      },
      "frontend": {
        "hooks": [
          {
            "name": "useClaraManifest",
            "purpose": "Auth-integrierter Manifest-Zugriff",
            "features": ["roleBasedAccess", "realTimeUpdates", "orientationBriefing"]
          }
        ],
        "components": [
          {
            "name": "MetaGovernorDashboard",
            "purpose": "Exklusives Dashboard für hiss@clara360.de",
            "features": ["slotManagement", "issueReporting", "systemOverview"]
          }
        ],
        "classes": [
          {
            "name": "ManifestManager",
            "purpose": "Zentrale Manifest-Verwaltung",
            "methods": ["createManifest", "updateSlotStatus", "reportCriticalIssue", "registerVaultFile"]
          }
        ]
      }
    },
    "users": {
      "metaGovernor": {
        "email": "hiss@clara360.de",
        "role": "metaGovernor",
        "permissions": ["manifest:read", "manifest:write", "vault:access", "system:admin"],
        "access": "full"
      },
      "manusA": {
        "email": "manus-a@system",
        "role": "manus", 
        "permissions": ["manifest:read", "manifest:write", "vault:access", "system:build"],
        "access": "limited"
      }
    },
    "dataFlow": {
      "manifestStorage": "supabase.manifest table",
      "accessControl": "RLS policies + role-based permissions",
      "dataPrivacy": "DSGVO-compliant, no public access",
      "auditTrail": "all changes tracked with user and timestamp"
    },
    "features": {
      "slotTracking": {
        "description": "Verfolgt Status aller System-Slots",
        "statuses": ["pending", "in_progress", "active", "complete", "inactive"]
      },
      "issueManagement": {
        "description": "Kritische Probleme melden und verfolgen",
        "priorities": ["low", "medium", "high", "critical"]
      },
      "vaultIntegration": {
        "description": "Registrierung und Verwaltung von Vault-Dateien",
        "location": "/root/clara360_rebuild/dist/"
      },
      "manusOrientation": {
        "description": "Automatische Orientierung für neue Manus-Einheiten",
        "includes": ["currentFocus", "urgentTasks", "systemHealth", "userAccess"]
      }
    },
    "deployment": {
      "vpsLocation": "/var/www/clara360/system/",
      "files": [
        "clara360_manifest_schema.sql",
        "useClaraManifest_auth.js", 
        "ManifestManager.js",
        "MetaGovernorDashboard.jsx"
      ],
      "nextSteps": [
        "Execute SQL schema in Supabase",
        "Integrate components into Clara360 frontend",
        "Test role-based access",
        "Validate DSGVO compliance"
      ]
    },
    "benefits": {
      "contextPersistence": "Systemstatus überlebt Chat-Wechsel",
      "roleBasedSecurity": "Nur autorisierte Benutzer haben Zugriff",
      "auditCompliance": "Vollständige Nachverfolgung aller Änderungen",
      "manusEfficiency": "Neue Einheiten können sofort anschließen",
      "dataPrivacy": "DSGVO-konform, keine öffentlichen Daten"
    }
  }
}

