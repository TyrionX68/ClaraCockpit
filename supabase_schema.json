    "sql_setup": {
      "create_tables": [
        "CREATE TABLE users (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), owner_id varchar(10) UNIQUE NOT NULL, name varchar(100) NOT NULL, email varchar(255) UNIQUE, password_hash varchar(255), active boolean DEFAULT true, created_at timestamp DEFAULT now(), updated_at timestamp DEFAULT now());",
        "CREATE TABLE objekte (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), objekt_id varchar(20) UNIQUE NOT NULL, owner_id varchar(10) NOT NULL, name varchar(200) NOT NULL, adresse varchar(300), typ varchar(100), einheiten integer DEFAULT 1, baujahr integer, wohnflaeche decimal(10,2), created_at timestamp DEFAULT now(), updated_at timestamp DEFAULT now());",
        "CREATE TABLE dashboard_kpis (id uuid PRIMARY KEY DEFAULT gen_random_uuid(), objekt_id varchar(20) NOT NULL, mieteinnahmen decimal(10,2) DEFAULT 0, rueckstaende decimal(10,2) DEFAULT 0, vermietungsgrad decimal(5,2) DEFAULT 0, rendite decimal(5,2) DEFAULT 0, instandhaltung_jahr decimal(10,2) DEFAULT 0, stichtag date DEFAULT CURRENT_DATE, created_at timestamp DEFAULT now(), updated_at timestamp DEFAULT now());"
      ],
      "create_indexes": [
        "CREATE INDEX idx_users_owner_id ON users(owner_id);",
        "CREATE INDEX idx_users_email ON users(email);",
        "CREATE INDEX idx_objekte_owner_id ON objekte(owner_id);",
        "CREATE INDEX idx_objekte_objekt_id ON objekte(objekt_id);",
        "CREATE INDEX idx_dashboard_kpis_objekt_id ON dashboard_kpis(objekt_id);",
        "CREATE INDEX idx_dashboard_kpis_stichtag ON dashboard_kpis(stichtag);"
      ],
      "create_foreign_keys": [
        "ALTER TABLE objekte ADD CONSTRAINT fk_objekte_owner FOREIGN KEY (owner_id) REFERENCES users(owner_id);",
        "ALTER TABLE dashboard_kpis ADD CONSTRAINT fk_dashboard_kpis_objekt FOREIGN KEY (objekt_id) REFERENCES objekte(objekt_id);"
      ]
    }
  },
  "feature_flags": {
    "VITE_USE_LOCAL_AUTH": {
      "description": "Verwende lokale JSON-Authentifizierung statt Supabase",
      "default": true,
      "values": {
        "true": "JSON-basierte Authentifizierung (Fallback)",
        "false": "Supabase-Authentifizierung"
      }
    },
    "VITE_ENABLE_SUPABASE_SYNC": {
      "description": "Aktiviere Supabase-Synchronisation im Hintergrund",
      "default": false,
      "values": {
        "true": "Daten werden mit Supabase synchronisiert",
        "false": "Nur lokale JSON-Daten"
      }
    }
  },
  "migration_strategy": {
    "phase_1": "JSON-Basis beibehalten, Supabase-Schema vorbereiten",
    "phase_2": "Parallele Supabase-Integration mit Feature-Flag",
    "phase_3": "Schrittweise Migration mit Daten-Sync",
    "phase_4": "Vollständige Supabase-Migration (optional)"
  }
}

