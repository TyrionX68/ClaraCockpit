{
  "supabase_schema": {
    "version": "1.0.0",
    "description": "Clara360 Eigentümer-Portal Supabase Schema",
    "tables": {
      "users": {
        "description": "Eigentümer-Benutzer mit Authentifizierung",
        "columns": {
          "id": {
            "type": "uuid",
            "primary_key": true,
            "default": "gen_random_uuid()"
          },
          "owner_id": {
            "type": "varchar(10)",
            "unique": true,
            "not_null": true,
            "description": "Eindeutige Eigentümer-ID (z.B. e001)"
          },
          "name": {
            "type": "varchar(100)",
            "not_null": true,
            "description": "Vollständiger Name des Eigentümers"
          },
          "email": {
            "type": "varchar(255)",
            "unique": true,
            "description": "E-Mail-Adresse für Authentifizierung"
          },
          "password_hash": {
            "type": "varchar(255)",
            "description": "Gehashtes Passwort (bcrypt)"
          },
          "active": {
            "type": "boolean",
            "default": true,
            "description": "Aktiver Status des Benutzers"
          },
          "created_at": {
            "type": "timestamp",
            "default": "now()"
          },
          "updated_at": {
            "type": "timestamp",
            "default": "now()"
          }
        },
        "indexes": [
          "CREATE INDEX idx_users_owner_id ON users(owner_id);",
          "CREATE INDEX idx_users_email ON users(email);"
        ]
      },
      "objekte": {
        "description": "Immobilienobjekte mit Eigentümer-Zuordnung",
        "columns": {
          "id": {
            "type": "uuid",
            "primary_key": true,
            "default": "gen_random_uuid()"
          },
          "objekt_id": {
            "type": "varchar(20)",
            "unique": true,
            "not_null": true,
            "description": "Eindeutige Objekt-ID (z.B. obj001)"
          },
          "owner_id": {
            "type": "varchar(10)",
            "not_null": true,
            "description": "Referenz auf users.owner_id"
          },
          "name": {
            "type": "varchar(200)",
            "not_null": true,
            "description": "Name/Adresse des Objekts"
          },
          "adresse": {
            "type": "varchar(300)",
            "description": "Vollständige Adresse"
          },
          "typ": {
            "type": "varchar(100)",
            "description": "Objekttyp (Mehrfamilienhaus, etc.)"
          },
          "einheiten": {
            "type": "integer",
            "default": 1,
            "description": "Anzahl Wohneinheiten"
          },
          "baujahr": {
            "type": "integer",
            "description": "Baujahr des Objekts"
          },
          "wohnflaeche": {
            "type": "decimal(10,2)",
            "description": "Wohnfläche in m²"
          },
          "created_at": {
            "type": "timestamp",
            "default": "now()"
          },
          "updated_at": {
            "type": "timestamp",
            "default": "now()"
          }
        },
        "indexes": [
          "CREATE INDEX idx_objekte_owner_id ON objekte(owner_id);",
          "CREATE INDEX idx_objekte_objekt_id ON objekte(objekt_id);"
        ],
        "foreign_keys": [
          "ALTER TABLE objekte ADD CONSTRAINT fk_objekte_owner FOREIGN KEY (owner_id) REFERENCES users(owner_id);"
        ]
      },
      "dashboard_kpis": {
        "description": "KPI-Daten pro Objekt für Dashboard-Anzeige",
        "columns": {
          "id": {
            "type": "uuid",
            "primary_key": true,
            "default": "gen_random_uuid()"
          },
          "objekt_id": {
            "type": "varchar(20)",
            "not_null": true,
            "description": "Referenz auf objekte.objekt_id"
          },
          "mieteinnahmen": {
            "type": "decimal(10,2)",
            "default": 0,
            "description": "Monatliche Mieteinnahmen in EUR"
          },
          "rueckstaende": {
            "type": "decimal(10,2)",
            "default": 0,
            "description": "Offene Rückstände in EUR"
          },
          "vermietungsgrad": {
            "type": "decimal(5,2)",
            "default": 0,
            "description": "Vermietungsgrad in Prozent"
          },
          "rendite": {
            "type": "decimal(5,2)",
            "default": 0,
            "description": "Netto-Rendite in Prozent"
          },
          "instandhaltung_jahr": {
            "type": "decimal(10,2)",
            "default": 0,
            "description": "Jährliche Instandhaltungskosten in EUR"
          },
          "stichtag": {
            "type": "date",
            "default": "CURRENT_DATE",
            "description": "Stichtag der KPI-Daten"
          },
          "created_at": {
            "type": "timestamp",
            "default": "now()"
          },
          "updated_at": {
            "type": "timestamp",
            "default": "now()"
          }
        },
        "indexes": [
          "CREATE INDEX idx_dashboard_kpis_objekt_id ON dashboard_kpis(objekt_id);",
          "CREATE INDEX idx_dashboard_kpis_stichtag ON dashboard_kpis(stichtag);"
        ],
        "foreign_keys": [
          "ALTER TABLE dashboard_kpis ADD CONSTRAINT fk_dashboard_kpis_objekt FOREIGN KEY (objekt_id) REFERENCES objekte(objekt_id);"
        ]
      }
    },
